# Host-run local development only. Copy values into the appropriate ignored
# application env files; do not use these credentials outside quorum-dev.
MIGRATOR_DATABASE_URL=postgres://quorum_operator:quorum-local-operator-only@127.0.0.1:54322/quorum_dev?sslmode=disable
LOCAL_TEST_DATABASE_URL=postgres://quorum_operator:quorum-local-operator-only@127.0.0.1:54322/quorum_dev?sslmode=disable
OPERATOR_DATABASE_URL=postgres://quorum_operator:quorum-local-operator-only@127.0.0.1:54322/quorum_dev?sslmode=disable
QUORUM_MIGRATOR_PASSWORD=replace-with-a-local-only-secret
QUORUM_AUTH_RUNTIME_PASSWORD=replace-with-a-different-local-only-secret
QUORUM_APP_RUNTIME_PASSWORD=replace-with-another-local-only-secret
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# Cross-container service discovery uses Compose DNS, never localhost:
# postgres://quorum_operator:quorum-local-operator-only@postgres:5432/quorum_dev?sslmode=disable
# http://mailpit:8025 and mailpit:1025
