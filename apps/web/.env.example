# Auth V2 server-only runtime. Use the quorum_auth_runtime role; never expose
# these values through NEXT_PUBLIC_* variables.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DATABASE_URL=postgres://quorum_auth_runtime:replace-local-auth-runtime-password@127.0.0.1:54322/quorum_dev?sslmode=disable
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Quorum <no-reply@quorum.local>
# Browser-visible API endpoint for the Go GraphQL server.
NEXT_PUBLIC_API_URL=http://localhost:8080/graphql
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_DEMO_RESET_ENABLED=false

# Neon Auth server-side proxy config for Next.js.
# Use the Auth URL from Neon, not the Data API REST URL.
NEON_AUTH_BASE_URL=https://replace-with-neon-auth-url
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-characters
