# Better Auth. All values are server-only.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DATABASE_URL=postgres://quorum_auth_runtime:replace-local-auth-runtime-password@127.0.0.1:54322/quorum_dev?sslmode=disable
# Nonproduction only: set false to bypass verification and continue directly to onboarding.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth. Register this exact callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local email delivery through Mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Set both values when the SMTP server requires authentication.
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=Quorum <no-reply@quorum.local>

# Private Next-to-Go boundary. The private key is base64url-encoded PKCS8 DER.
INTERNAL_API_BASE_URL=http://127.0.0.1:8080
# Production one-host deployments use this instead of INTERNAL_API_BASE_URL.
# INTERNAL_API_SOCKET_PATH=/run/quorum/api.sock
INTERNAL_ASSERTION_ISSUER=quorum-next
INTERNAL_ASSERTION_AUDIENCE=quorum-go
INTERNAL_ASSERTION_KEY_ID=local-active
INTERNAL_ASSERTION_PRIVATE_KEY=replace-with-base64url-pkcs8-ed25519-private-key
