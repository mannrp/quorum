PORT=8080
# Production one-host deployments use this private Unix socket instead of a TCP port.
# INTERNAL_API_SOCKET_PATH=/run/quorum/api.sock
APP_ENV=development

# Product runtime database role.
DATABASE_URL=postgres://quorum_app_runtime:replace-local-app-runtime-password@127.0.0.1:54322/quorum_dev?sslmode=disable

# Comma-separated kid:base64url-raw-Ed25519-public-key entries.
INTERNAL_ASSERTION_ISSUER=quorum-next
INTERNAL_ASSERTION_AUDIENCE=quorum-go
INTERNAL_ASSERTION_PUBLIC_KEYS=local-active:replace-with-base64url-raw-ed25519-public-key
